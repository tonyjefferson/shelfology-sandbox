<style>
.shelfPlanner{font-family:inherit,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;color:#171717;background:#ffffff;border:1px solid #e7e5df;border-radius:16px;padding:22px;max-width:820px;box-sizing:border-box;line-height:1.5;margin:0 auto}
.shelfPlanner *{box-sizing:border-box}
.shelfPlanner .sp-h{font-size:20px;font-weight:600;margin:0 0 4px}
.shelfPlanner .sp-sub{font-size:14px;color:#6b6b6b;margin:0 0 18px}
.shelfPlanner .sp-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.shelfPlanner .sp-span{grid-column:1 / -1}
.shelfPlanner label{display:block;font-size:13px;font-weight:600;margin:0 0 6px}
.shelfPlanner select{width:100%;height:42px;border:1px solid #dcdad3;border-radius:10px;background:#fff;padding:0 12px;font-size:14px;color:#171717;font-family:inherit}
.shelfPlanner input[type=range]{width:100%;accent-color:#171717;margin-top:6px}
.shelfPlanner .sp-len b{font-weight:700}
.shelfPlanner .sp-res{margin-top:20px;border-top:1px solid #eeece6;padding-top:18px}
.shelfPlanner .sp-badge{display:inline-block;font-size:14px;font-weight:700;padding:8px 14px;border-radius:999px;margin-bottom:14px}
.shelfPlanner .g{background:#e7f4ec;color:#1f6b46}
.shelfPlanner .w{background:#fbf1db;color:#8a5a10}
.shelfPlanner .b{background:#fbe9e7;color:#a82f22}
.shelfPlanner .sp-bar{position:relative;height:26px;background:#f2f1ec;border-radius:8px;overflow:hidden;margin-bottom:6px}
.shelfPlanner .sp-fill{position:absolute;left:0;top:0;bottom:0;width:0;transition:width .2s ease}
.shelfPlanner .fg{background:#43a06b}
.shelfPlanner .fw{background:#e0a53c}
.shelfPlanner .fb{background:#e05a4d}
.shelfPlanner .sp-blab{font-size:12px;color:#6b6b6b;margin:0 0 16px}
.shelfPlanner .sp-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:16px}
.shelfPlanner .sp-m{background:#f7f6f1;border-radius:10px;padding:11px 12px}
.shelfPlanner .sp-m .k{font-size:12px;color:#6b6b6b;margin:0 0 3px}
.shelfPlanner .sp-m .v{font-size:19px;font-weight:700;margin:0}
.shelfPlanner .sp-rec{font-size:14px;background:#f2f5f3;border-left:3px solid #171717;padding:11px 13px;border-radius:0 8px 8px 0;margin-bottom:14px}
.shelfPlanner ul.sp-warn{list-style:none;margin:0 0 16px;padding:0}
.shelfPlanner ul.sp-warn li{font-size:13px;color:#3f3f3f;padding:7px 0 7px 22px;position:relative;border-top:1px solid #f0eee8}
.shelfPlanner ul.sp-warn li:before{content:"!";position:absolute;left:0;top:7px;width:16px;height:16px;line-height:16px;text-align:center;font-size:11px;font-weight:700;color:#8a5a10;background:#fbf1db;border-radius:50%}
.shelfPlanner ul.sp-warn li.crit:before{color:#a82f22;background:#fbe9e7}
.shelfPlanner .sp-cta{display:flex;flex-wrap:wrap;gap:10px}
.shelfPlanner a.sp-btn{display:inline-block;font-size:13px;font-weight:600;text-decoration:none;padding:10px 15px;border-radius:10px;border:1px solid #171717;color:#171717;background:#fff}
.shelfPlanner a.sp-btn.pri{background:#171717;color:#fff}
.shelfPlanner .sp-disc{font-size:11px;color:#9a9a9a;margin:16px 0 0}
@media (max-width:560px){
.shelfPlanner .sp-grid{grid-template-columns:1fr}
.shelfPlanner .sp-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}
}
</style>
<div class="shelfPlanner" id="shelfPlanner">
<p class="sp-h">Floating Shelf Planner</p>
<p class="sp-sub">Answer a few questions and we'll estimate what your wall can hold and which setup to use.</p>
<div class="sp-grid">
<div><label>What's behind the wall?</label>
<select id="sp_wall">
<option value="wood">Wood studs</option>
<option value="steel">Steel studs</option>
<option value="masonry">Brick or concrete</option>
<option value="plaster">Lath and plaster</option>
<option value="drywall">Drywall only, no studs where I want it</option>
</select></div>
<div><label>Stud spacing</label>
<select id="sp_spacing">
<option value="16">16" on center</option>
<option value="24">24" on center</option>
<option value="unsure">Not sure</option>
</select></div>
<div class="sp-span sp-len"><label>Shelf length: <b><span id="sp_lenOut">36</span>"</b></label>
<input type="range" id="sp_len" min="12" max="96" step="1" value="36"></div>
<div><label>Depth</label>
<select id="sp_depth">
<option value="6">6"</option>
<option value="8">8"</option>
<option value="10" selected>10"</option>
<option value="12">12"</option>
</select></div>
<div><label>Thickness</label>
<select id="sp_thick">
<option value="1.5">1.5"</option>
<option value="1.75" selected>1.75"</option>
<option value="2">2"</option>
<option value="2.5">2.5"</option>
</select></div>
<div><label>Shelf material</label>
<select id="sp_wood">
<option value="oak">Solid white oak</option>
<option value="walnut">Solid walnut</option>
<option value="maple">Solid maple</option>
<option value="mdf">MDF (not recommended)</option>
</select></div>
<div><label>Mostly holding&hellip;</label>
<select id="sp_load">
<option value="books">Books and media</option>
<option value="dishware">Dishware and glassware</option>
<option value="decor">Decor, plants, frames</option>
<option value="mixed">A mix of things</option>
</select></div>
</div>
<div class="sp-res">
<span class="sp-badge" id="sp_badge">&mdash;</span>
<div class="sp-bar"><div class="sp-fill" id="sp_fill"></div></div>
<p class="sp-blab" id="sp_blab"></p>
<div class="sp-metrics">
<div class="sp-m"><p class="k">Anchor points</p><p class="v" id="sp_pts">&mdash;</p></div>
<div class="sp-m"><p class="k">Est. capacity</p><p class="v" id="sp_cap">&mdash;</p></div>
<div class="sp-m"><p class="k">Planned load</p><p class="v" id="sp_ld">&mdash;</p></div>
<div class="sp-m"><p class="k">Shelf weight</p><p class="v" id="sp_sw">&mdash;</p></div>
</div>
<div class="sp-rec" id="sp_rec"></div>
<ul class="sp-warn" id="sp_warn"></ul>
<div class="sp-cta" id="sp_cta"></div>
</div>
<p class="sp-disc">Planning estimates only, based on quality internal brackets anchored into solid structure. Not an engineering guarantee. For heavy or custom loads, talk to a Shelf Geek.</p>
</div>
<script>
(function(){
var D={oak:47,walnut:40,maple:44,mdf:48};
var PF={books:18,dishware:12,decor:5,mixed:10};
var root=document.getElementById('shelfPlanner');
function g(id){return document.getElementById(id);}
function calc(){
var wall=g('sp_wall').value;
var spSel=g('sp_spacing').value;
var len=parseFloat(g('sp_len').value);
var depth=parseFloat(g('sp_depth').value);
var thick=parseFloat(g('sp_thick').value);
var wood=g('sp_wood').value;
var load=g('sp_load').value;
g('sp_lenOut').textContent=len;
var spacing=spSel==='24'?24:16;
var unsure=spSel==='unsure';
var pts=0,per=0,wallNote='';
if(wall==='wood'){per=45;pts=Math.floor(len/spacing)+1;}
else if(wall==='steel'){per=35;pts=Math.floor(len/spacing)+1;wallNote='Use fasteners rated for steel studs.';}
else if(wall==='plaster'){per=35;pts=Math.floor(len/spacing)+1;wallNote='Anchor into the studs or blocking behind the plaster, not the plaster itself.';}
else if(wall==='masonry'){per=55;pts=Math.floor(len/16)+1;wallNote='Use masonry anchors rated for brick or concrete.';}
else{per=0;pts=0;}
var depthFactor=Math.min(1,1-(depth-8)*0.035);
var cap;
if(wall==='drywall'){cap=22;}
else{cap=pts*per*depthFactor;}
if(wood==='mdf'){cap=Math.min(cap,40);}
cap=Math.max(0,Math.round(cap/5)*5);
var estLoad=Math.round(PF[load]*(len/12));
var selfW=Math.round((thick*depth*len)/1728*D[wood]);
var ratio=estLoad>0?cap/estLoad:99;
var status;
if(cap<=0)status='b';
else if(ratio>=1.5)status='g';
else if(ratio>=1.0)status='w';
else status='b';
if(wood==='mdf'&&status==='g')status='w';
var badge=g('sp_badge');
badge.className='sp-badge '+status;
if(wall==='drywall')badge.textContent='Not enough support here';
else if(status==='g')badge.textContent='Comfortable, with room to spare';
else if(status==='w')badge.textContent=wood==='mdf'?"Workable, but we'd choose hardwood":'Cutting it close, plan carefully';
else badge.textContent='Under-spec, adjust your plan';
var fill=g('sp_fill');
var pct=cap>0?Math.min(100,Math.round(estLoad/cap*100)):100;
fill.style.width=pct+'%';
fill.className='sp-fill '+(status==='g'?'fg':status==='w'?'fw':'fb');
g('sp_blab').textContent='About '+estLoad+' lb of planned load against roughly '+cap+' lb of capacity.';
g('sp_pts').textContent=wall==='drywall'?'0':pts;
g('sp_cap').textContent='~'+cap+' lb';
g('sp_ld').textContent='~'+estLoad+' lb';
g('sp_sw').textContent='~'+selfW+' lb';
var recBracket=wall==='drywall'?'heavy-duty toggle bolts, kept to light loads':'a rated internal floating-shelf bracket';
var anchorTxt=wall==='drywall'?'drywall (no studs)':wall==='masonry'?(pts+' masonry anchor points'):(pts+' stud'+(pts===1?'':'s'));
g('sp_rec').innerHTML='<b>Recommended setup:</b> '+recBracket+', anchored into '+anchorTxt+'. Estimated capacity ~'+cap+' lb versus ~'+estLoad+' lb planned.';
var w=[];
if(wood==='mdf')w.push({t:"MDF is a budget material that bows over time, even when the bracket is solid. We don't recommend it for floating shelves — solid white oak, walnut, or maple holds more and lasts far longer.",c:true});
if(wall==='drywall')w.push({t:'No studs where you want the shelf. A true floating shelf can only carry a light load on toggle bolts here. For display, a picture ledge is the better answer.',c:false});
if(wall!=='drywall'&&wall!=='masonry'&&pts<2)w.push({t:'At '+len+'", the shelf may only catch one stud. Extend to at least '+(spacing+1)+'" to reliably cross two studs.',c:false});
if(estLoad>cap&&cap>0)w.push({t:'Your planned load is above the estimated capacity. Add length to hit more studs, lighten the load, or step up the bracket.',c:false});
if(unsure&&wall!=='masonry'&&wall!=='drywall')w.push({t:'We assumed 16" stud spacing. Confirm with a stud finder, since older homes vary.',c:false});
w.push({t:'Skip the thin prong brackets packed with budget shelves; they give out above about 30 lb. Use a rated internal bracket.',c:false});
if(wallNote)w.push({t:wallNote,c:false});
g('sp_warn').innerHTML=w.map(function(o){return '<li'+(o.c?' class="crit"':'')+'>'+o.t+'</li>';}).join('');
var base='https://shelfology.com';
var cta=[];
cta.push('<a class="sp-btn pri" href="'+base+'/collections/floating-shelves">Shop floating shelves</a>');
cta.push('<a class="sp-btn" href="'+base+'/collections/floating-shelf-brackets">Shop brackets</a>');
if(wall==='drywall'||status==='b'||pts<2)cta.push('<a class="sp-btn" href="'+base+'/collections/picture-ledges">Shop picture ledges</a>');
cta.push('<a class="sp-btn" href="'+base+'/pages/contact-us">Talk to a Shelf Geek</a>');
g('sp_cta').innerHTML=cta.join('');
}
root.querySelectorAll('select,input').forEach(function(el){el.addEventListener('input',calc);});
calc();
})();
</script>
